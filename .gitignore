# ERP Azhan API — .gitignore

# Environment secrets
.env

# Build output
/bin/
*.exe

# Node (jika ada tooling frontend di masa depan)
node_modules/

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

/uploads/*
!/uploads/airline-logos/
!/uploads/airline-logos/**
!/uploads/brand-icons/
!/uploads/brand-icons/**
!/uploads/brand-logos/
!/uploads/brand-logos/**
/scratch/
.runlogs/

# Berkas kerja lokal: dump database (berisi hash password dan data pribadi jamaah) dan sejenisnya.
/tmp/
*.sql.gz
backup-*.sql
