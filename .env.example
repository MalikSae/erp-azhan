# Environment Variables — ERP Azhan API
# Salin file ini menjadi .env dan isi dengan nilai sebenarnya.
# JANGAN commit file .env ke repository.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=erp_azhan_dev

# Server
APP_PORT=9090
# production | development. WAJIB "production" di server publik: mematikan origin CORS
# pengembangan (localhost, *.test), dan mencegah
# isi email (token) ditulis ke log. Kosong diperlakukan sebagai non-produksi.
APP_ENV=development
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://travel.example.com,https://*.example.com
# Reverse proxy tepercaya (IP/CIDR, pisah koma) selain loopback — header
# CF-Connecting-IP / X-Forwarded-For hanya dibaca dari alamat ini.
# Contoh Docker: subnet network tempat container Caddy/Nginx berjalan.
TRUSTED_PROXIES=

# JWT Authentication
# WAJIB diisi di SEMUA lingkungan: API menolak start bila kosong, < 32 karakter, atau masih
# nilai contoh. Buat dengan: openssl rand -hex 32
JWT_SECRET=
# Maksimal 60 menit (nilai lebih besar dibatasi 60).
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Cloudflare Turnstile (captcha daftar akun & booking mandiri). OPSIONAL: kosong = captcha nonaktif
# (hanya rate limit yang menjaga endpoint publik); isi untuk mengaktifkan.
# Key uji Cloudflare: 1x0000000000000000000000000000000AA (selalu lolos),
# 2x0000000000000000000000000000000AA (selalu gagal).
TURNSTILE_SECRET_KEY=
# Isi TURNSTILE_SECRET_KEY bersamaan dengan NEXT_PUBLIC_TURNSTILE_SITE_KEY di situs brand.

# Zona waktu bisnis: dipakai time.Now(), JSON, dan sesi MySQL (NOW(), CURRENT_DATE).
APP_TIMEZONE=Asia/Jakarta

# Email transaksional (verifikasi email, reset password, booking dibuat)
# Kosongkan SMTP_HOST hanya untuk dev: email ditulis ke log API. Di APP_ENV=production tanpa
# SMTP_HOST email TIDAK dikirim (peringatan keras di log, isi/token tidak dicatat).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Tautan di email dibentuk dari domain brand di database. {domain} diganti domain brand.
# Dev: http://{domain}:3100  Produksi: https://{domain} (default)
SITE_URL_TEMPLATE=
