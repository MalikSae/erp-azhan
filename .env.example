# Environment Variables — ERP Azhan API
# Salin file ini menjadi .env dan isi dengan nilai sebenarnya.
# JANGAN commit file .env ke repository.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=erp_azhan_dev

# Server
APP_PORT=9090
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://travel.example.com,https://*.example.com
# Reverse proxy tepercaya (IP/CIDR, pisah koma) selain loopback — header
# CF-Connecting-IP / X-Forwarded-For hanya dibaca dari alamat ini.
# Contoh Docker: subnet network tempat container Caddy/Nginx berjalan.
TRUSTED_PROXIES=

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Cloudflare Turnstile (captcha booking publik & daftar agen). Kosong = verifikasi NONAKTIF
# (hanya untuk development). Key uji Cloudflare: 1x0000000000000000000000000000000AA
# (selalu lolos), 2x0000000000000000000000000000000AA (selalu gagal).
TURNSTILE_SECRET_KEY=
# Isi TURNSTILE_SECRET_KEY bersamaan dengan NEXT_PUBLIC_TURNSTILE_SITE_KEY di azhan-microsite.

# Zona waktu bisnis: dipakai time.Now(), JSON, dan sesi MySQL (NOW(), CURRENT_DATE).
APP_TIMEZONE=Asia/Jakarta
